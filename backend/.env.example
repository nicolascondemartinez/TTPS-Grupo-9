# Copiar a .env y completar. Nunca subir el .env al repo.
FLASK_ENV=development
SECRET_KEY=

# Supabase: pooler (6543) para la app; conexión directa o session pooler (5432) para Alembic
DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:6543/postgres

# URL del frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Módulos externos: mock | real
ADAPTERS_MODE=mock
OBRAS_SOCIALES_API_URL=
OBRAS_SOCIALES_API_KEY=

# Token para disparar jobs desde un cron externo
INTERNAL_JOBS_TOKEN=
