# Copiar a .env y completar. Nunca subir el .env al repo.
FLASK_ENV=development
SECRET_KEY=

# Supabase: pooler (6543) para la app; conexión directa (5432)
DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:6543/postgres

# URL del frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Módulos externos (ver src/adapters/README.md)
# Modo por defecto de todos los módulos: mock | real
ADAPTERS_MODE=mock
# Por módulo: MODULO_MODE (vacío = ADAPTERS_MODE), MODULO_API_URL, MODULO_API_KEY, MODULO_TIMEOUT (opcional)

# Obras sociales
OBRAS_SOCIALES_MODE=
OBRAS_SOCIALES_API_URL=
OBRAS_SOCIALES_API_KEY=

# Bioinformática (módulo 5)
BIOINFORMATICA_MODE=
BIOINFORMATICA_API_URL=
BIOINFORMATICA_API_KEY=

# SNOMED (módulo 2)
SNOMED_MODE=
SNOMED_API_URL=
SNOMED_API_KEY=

# Familiograma (módulo 1)
FAMILIOGRAMA_MODE=
FAMILIOGRAMA_API_URL=
FAMILIOGRAMA_API_KEY=

# Cupones (módulo 3)
CUPONES_MODE=
CUPONES_API_URL=
CUPONES_API_KEY=

# Chatbot (módulo 8): API_KEY es el token del grupo (secreto); PUBLISHABLE_KEY es la clave igual para todos
CHATBOT_MODE=
CHATBOT_API_URL=
CHATBOT_API_KEY=
CHATBOT_PUBLISHABLE_KEY=

# Token para disparar jobs desde un cron externo
INTERNAL_JOBS_TOKEN=

# Recorridos
RECORRIDOS_MODE=
RECORRIDOS_API_URL=
RECORRIDOS_API_KEY=