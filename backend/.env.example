# Copiar a .env y completar. Nunca subir el .env al repo.
FLASK_ENV=development
SECRET_KEY=

# Supabase: pooler (6543) para la app; conexión directa (5432)
DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:6543/postgres

# URL del frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Módulos externos (ver src/adapters/README.md)
# Modo por defecto de todos los módulos: mock | real
ADAPTERS_MODE=mock
# Por módulo: MODULO_MODE (vacío = ADAPTERS_MODE), MODULO_API_URL, MODULO_API_KEY, MODULO_TIMEOUT (opcional)

# Obras sociales
OBRAS_SOCIALES_MODE=
OBRAS_SOCIALES_API_URL=
OBRAS_SOCIALES_API_KEY=

# Token para disparar jobs desde un cron externo
INTERNAL_JOBS_TOKEN=
